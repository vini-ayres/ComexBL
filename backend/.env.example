# Server
PORT=3333
NODE_ENV=development

# SQL Server
# Senhas com ! @ # * etc.: use aspas duplas. Ex.: DB_PASSWORD="!@#senha*123"
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD="your_password_here"
DB_NAME=DB_OCR_FCA
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT=30000
DB_REQUEST_TIMEOUT=30000

# DATABASE_URL é montada automaticamente em runtime (src/config/env.ts).
# Para Prisma CLI (migrate, db pull), defina manualmente ou copie do log de startup.

# GlobalSys (SQL Server externo — consulta TB_BL)
# Valores do .env são o fallback. Depois do primeiro "Salvar" na tela
# Banco de Dados, a configuração persistida no banco prevalece.
# GS_DB_AUTH_MODE:
#   ntlm — usuário de domínio Windows (requer GS_DB_DOMAIN + GS_DB_USER + GS_DB_PASSWORD)
#   sql  — autenticação SQL Server nativa (login/senha do banco)
# Se GS_DB_DOMAIN estiver definido e GS_DB_AUTH_MODE vazio, o padrão é ntlm.
# Para instância nomeada use GS_DB_SERVER=host\INSTANCIA (porta ignorada).
GS_DB_SERVER=
GS_DB_PORT=1433
GS_DB_NAME=
GS_DB_DOMAIN=
GS_DB_AUTH_MODE=
GS_DB_USER=
GS_DB_PASSWORD=
GS_DB_ENCRYPT=false
GS_DB_TRUST_SERVER_CERTIFICATE=true
GS_DB_CONNECTION_TIMEOUT=30000
GS_DB_REQUEST_TIMEOUT=30000

# n8n — webhook outbound (XML GlobalSys)
# N8N_WEBHOOK_ENVIAR_XML_GLOBALSYS_URL=

# Pasta local dos arquivos OCR (padrão: <repo>/files)
# FILES_DIR=/caminho/absoluto/para/files

# Active Directory / LDAP (autenticação via BIND)
# Valores do .env são o fallback. Depois do primeiro "Salvar" na tela
# LDAP / Active Directory, a configuração persistida no banco prevalece.
# Use LDAP_URL ou LDAP_HOST + LDAP_PORT. Grupos esperados: GG_OCR_BL_ADMIN, GG_OCR_BL_SUPERVISOR, GG_OCR_BL_OPERADOR
LDAP_URL=ldap://ad01.empresa.com.br:389
# LDAP_HOST=ad01.empresa.com.br
# LDAP_PORT=389
LDAP_BASE_DN=DC=empresa,DC=com,DC=br
# LDAP_BIND_DN=CN=svc_ocr_bl,OU=Service Accounts,DC=empresa,DC=com,DC=br
# Alternativa ao DN: UPN da service account (use um dos dois)
# LDAP_BIND_UPN=service.abapass@fcalog.local
LDAP_BIND_PASSWORD="your_service_account_password"
LDAP_USE_TLS=false
LDAP_GROUP_PREFIX=GG_OCR_BL_

# JWT (sessão da API após login LDAP)
# Duração da sessão: 7d, 24h, 12h, etc. Fecha o navegador não encerra a sessão.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN=7d
